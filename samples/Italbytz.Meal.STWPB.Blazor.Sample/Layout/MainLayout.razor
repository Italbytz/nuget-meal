@inherits LayoutComponentBase

<div class="shell">
    <header class="masthead">
        <div class="brand-block">
            <p class="eyebrow">nuget-meal sample</p>
            <p class="brand">STWPB Mensa Hamm</p>
            <p class="subtitle">Static GitHub Pages sample with nightly-refreshed meal data.</p>
        </div>
        <div class="header-actions">
            <a class="ghost-link" href="https://italbytz.github.io/nuget-meal/" target="_blank" rel="noreferrer">Documentation</a>
            <a class="primary-link" href="https://www.studierendenwerk-pb.de/gastronomie/speiseplaene/mensa-basilica-hamm" target="_blank" rel="noreferrer">Official menu</a>
        </div>
    </header>

    <nav class="top-nav" aria-label="Sample navigation">
        <NavLink href="/" Match="NavLinkMatch.All" class="nav-link">Mensa</NavLink>
        <NavLink href="/info" class="nav-link">Info</NavLink>
    </nav>

    <main>
        @Body
    </main>
</div>